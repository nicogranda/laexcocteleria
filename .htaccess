Options -Indexes
RewriteEngine On

# Construir la redirección desde la URL solicitada, no desde la ruta del disco.
RewriteCond %{REQUEST_URI} ^(.*/)$
RewriteRule ^$ %1public_html/ [R=302,L,NE]

# Proteger los archivos de configuración y el código del proyecto.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(app|vendor|vendor_old)(/|$) - [F,L,NC]
