Options -MultiViews

RewriteEngine On

# ============================================
# NO REESCRIBIR ARCHIVOS NI CARPETAS REALES
# ============================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ============================================
# HOME
# ============================================

RewriteRule ^$ index.php?page=home [QSA,L]
RewriteRule ^es/?$ index.php?page=home&lang=ES [QSA,L]


# ============================================
# PÁGINAS
# ============================================

RewriteRule ^(gallery|galeria|galería)/?$ index.php?page=page&slug=galeria [QSA,L]

# LANDINGS: catálogo Page, con SEO resuelto en index.php.
RewriteRule ^(cocteleria-eventos-donostia|catering-cocteleria-gipuzkoa|bartender-para-eventos)/?$ index.php?page=page&slug=$1 [QSA,L]

# CONTACTO ES
RewriteRule ^es/contacto/?$ index.php?page=contact&action=index&lang=ES [QSA,L]
RewriteRule ^es/contacto/enviar/?$ index.php?page=contact&action=mail&lang=ES [QSA,L]
RewriteRule ^es/confirmacion/?$ index.php?page=contact&action=thanks&lang=ES [QSA,L]

RewriteRule ^nosotros/?$ index.php?page=about [QSA,L]


# ============================================
# ADMIN
# ============================================

RewriteRule ^admin/?$ index.php?page=admin&action=login [QSA,L]


# ============================================
# SERVICIOS
# ============================================

RewriteRule ^servicios/([a-zA-Z0-9-]+)/?$ index.php?page=service&slug=$1 [QSA,L]


# ============================================
# POLICIES
# ============================================

RewriteRule ^es/(aviso-legal|politica-de-privacidad|politica-de-cookies|terminos-y-condiciones)/?$ index.php?page=policy&slug=$1&lang=ES [QSA,L]

